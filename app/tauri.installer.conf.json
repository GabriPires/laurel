{
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Laurel",
    "copyright": "Laurel contributors, GNU GPL version 2 or later",
    "category": "Video",
    "shortDescription": "Game clip recorder",
    "longDescription": "Laurel keeps the last seconds of the game you are playing and saves them as a clip when you press a hotkey.",
    "resources": {
      "../target/laurel-installer/engine/": "engine/",
      "../target/laurel-installer/laurel-steam.exe": "laurel-steam.exe",
      "../steam/LICENSE": "LICENSE-laurel-steam.txt",
      "../LICENSE": "LICENSE",
      "../THIRD-PARTY-NOTICES.md": "THIRD-PARTY-NOTICES.md"
    },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer/hooks.nsh",
        "languages": ["English", "PortugueseBR"],
        "compression": "lzma"
      }
    }
  }
}
